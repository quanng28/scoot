# Server-side only (Vercel project env or ignored .env.local). Never prefix with VITE_; never commit real values.
# disabled (default) | mock (labelled offline stand-in, no provider call) | live (real Gemini requests; needs authorisation)
GEMINI_PROVIDER_MODE=disabled
# Create in Google AI Studio and enter only in the deployment environment, never in chat or source.
GEMINI_API_KEY=
# Pinned to IDs found in the official docs on 2026-10-25; other values fail closed.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# sha256 hex of the demo access code (>= 16 random chars, e.g. openssl rand -base64 18) testers type at runtime:
#   printf %s 'code' | shasum -a 256
GEMINI_ACCESS_CODE_SHA256=
# true = anyone on an allowed origin may request AI explanations WITHOUT the access code (public demo).
# Cloud voice still needs the code. Only set this after a Google Cloud request quota/budget cap exists.
GEMINI_PUBLIC_REPORTS=false
# Exact origins, comma-separated, e.g. https://your-preview.vercel.app
GEMINI_ALLOWED_ORIGINS=
# Per-instance backstops; also set a project quota/budget alert in Google Cloud before live use.
GEMINI_REPORT_MAX_PER_HOUR=10
GEMINI_TTS_MAX_PER_HOUR=60
GEMINI_MAX_REQUESTS_PER_INSTANCE=200

# Report pipeline: unset/empty defaults to direct; opt in with langchain. Server-side only.
SCOOT_LLM_PIPELINE=
# Evaluation process only; server requests always suppress LangSmith tracing.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=

{
  "name": "scoot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts server api",
    "test": "vitest run && node --test src/catalog/*.test.mjs",
    "build": "tsc -p tsconfig.build.json && npm run app:build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "pose:build": "npm run build && node dist/scripts/build-pose-demo.js",
    "pose:preview": "node dist/scripts/pose-preview.js",
    "app:assets": "node scripts/build-app-assets.mjs",
    "app:dev": "npm run app:assets && vite --port 5173 --strictPort",
    "app:build": "npm run app:assets && vite build",
    "app:preview": "vite preview --port 4174 --strictPort",
    "app:browser-check": "node scripts/app-browser-check.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
